{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["core.ts", "File Hierarchy.ts", "tests/**/*.ts", "scripts/generate-test-cases.ts", "vitest.config.ts"]
}
